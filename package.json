    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "exceljs": "^4.4.0",
    "idb": "^8.0.0",
    "pinia": "^2.2.6",
    "tesseract.js": "^6.0.1",
    "tesseract.js-core": "^6.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "archiver": "^5.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1"
