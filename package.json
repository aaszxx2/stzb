{
  "name": "sutu-fund-ledger",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "率土军费账本 - 移动端优先的 PWA 记账应用",
  "scripts": {
    "dev": "node scripts/copy-runtime-assets.js && node scripts/generate-icons.js && vite --host",
    "build": "node scripts/copy-runtime-assets.js && node scripts/generate-icons.js && vite build",
    "preview": "vite preview --host",
